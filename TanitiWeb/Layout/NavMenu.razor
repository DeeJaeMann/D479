<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <h1><a class="navbar-brand" href="">Taniti Island</a></h1>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <img src="images/island_image01.jpg" class="header-image" alt="Island Image" />

    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                About Taniti
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="accommodations">
                Accommodations
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="activities">
                Activities
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dining">
                Dining
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="visitorinfo">
                Visitor Info
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

}