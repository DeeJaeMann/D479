@page "/"
@using TanitiWeb.Components

<PageTitle>Taniti : Home</PageTitle>

<div class="card mb-4">
    <div class="row g-0">
        
        <div class="col-md-8">
            <div class="card-header custom-header">
                Welcome to Taniti Island
            </div>
            <div class="card-body">
                @* <h2 class="card-title">Welcome to Taniti Island</h2> *@
                <p class="card-text">
                    Taniti is a small tropical island in the Pacific known for its diverse landscapes and
                    welcoming atmosphere. Visitors can experience sandy and rocky beaches, lush rainforests,
                    and a mountainous interior that includes a small active volcano. The island is home to
                    an indigenous population of about 20,000 and has recently begun expanding its tourism
                    offerings.
                </p>
            </div>
        </div>
        
        <div class="col-md-4">
            <img src="images/placeholder.png"
                 alt="Island Image"
                 class="img-fluid rounded-end island-image mx-auto d-block" />
        </div>

    </div>
</div>

<div class="card mb-4">
    <div class="row g-0">
        
        <div class="col-md-8">
            <div class="card-header custom-header">
                Why visit Taniti?
            </div>
            <div class="card-body">
                @* <h2 class="card-title">Why Visit Taniti?</h2> *@
                <p class="card-text">
                    Taniti offers a blend of natural beauty, cultural charm, and convenient amenities.
                    Travelers can enjoy beaches, rainforest exploration, and scenic views around Yellow Leaf
                    Bay. The island provides a variety of dining options, comfortable lodging choices, and
                    easy transportation around Taniti City. With activities ranging from snorkeling and
                    fishing tours to museums and art galleries, visitors can enjoy both relaxation and
                    adventure during their stay.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <img src="images/placeholder.png"
                 alt="Why Visit Image"
                 class="img-fluid rounded-end island-image mx-auto d-block" />
        </div>

    </div>
</div>

<WeatherForecastWidget />